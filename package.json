{
  "name": "khaoyu-note-web",
  "private": true,
  "version": "0.36.0",
  "type": "module",
  "description": "Local web host for Khaoyu Note, backed by the same SQLite database as the desktop app",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/dezuhan/khaoyu-note.git"
  },
  "bugs": {
    "url": "https://github.com/dezuhan/khaoyu-note/issues"
  },
  "homepage": "https://github.com/dezuhan/khaoyu-note#readme",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "web": "node server.mjs",
    "web:status": "node -e \"fetch('http://127.0.0.1:1430/status').then(r=>r.text()).then(console.log)\"",
    "service": "node service/src/server.mjs",
    "service:migrate": "node service/src/cli.mjs migrate",
    "service:rollback": "node service/src/cli.mjs rollback",
    "service:status": "node service/src/cli.mjs status",
    "service:bootstrap": "node service/src/cli.mjs bootstrap",
    "service:backup": "node service/src/cli.mjs backup",
    "service:restore": "node service/src/cli.mjs restore",
    "test:service": "node --test --test-concurrency=1 service/test/service.test.mjs service/test/auth.test.mjs service/test/admin.test.mjs service/test/storage.test.mjs service/test/storage-migrations.test.mjs service/test/postgres-runtime.test.mjs service/test/redis-bus.test.mjs service/test/config.test.mjs service/test/sanitize.test.mjs service/test/object-encryption.test.mjs service/test/worker.test.mjs",
    "test:sync": "node --no-warnings tools/test-sync.mjs",
    "test:update": "node --no-warnings tools/test-update.mjs",
    "test:auto-backup": "node --no-warnings tools/test-auto-backup.mjs",
    "test:disabled-cards": "node --no-warnings tools/test-disabled-cards.mjs",
    "test:auth-web": "node --no-warnings tools/test-auth-web.mjs",
    "test:passkeys": "node tools/test-passkeys.mjs",
    "test:account-ui": "node tools/test-account-ui.mjs",
    "test:shares-ui": "node tools/test-shares-ui.mjs",
    "test:share-view": "node tools/test-share-view.mjs",
    "test:onboarding": "node tools/test-onboarding.mjs",
    "dist:checksums": "node tools/checksums.mjs --dir dist",
    "i18n:audit": "node tools/i18n-audit.mjs",
    "test:theme": "node tools/test-theme-global.mjs",
    "theme:sync": "node tools/sync-theme.mjs",
    "theme:check": "node tools/sync-theme.mjs --check",
    "test:theme-module": "node --test tools/test-theme-module.test.mjs",
    "test:theme-css": "node tools/test-theme-css.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
