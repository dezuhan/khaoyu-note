# Team profile: the service refuses to start without PostgreSQL and Redis.
# Copy to .env.team and replace every change-me value, or run scripts/setup-team.sh.
KHAOYU_SERVICE_PROFILE=team

# Public origin of the service frontend. Default is the local published port.
# For Cloudflare Tunnel or a TLS reverse proxy, replace both values with the public HTTPS origin and
# set KHAOYU_SERVICE_COOKIE_SECURE=true.
KHAOYU_SERVICE_PUBLIC_URL=http://127.0.0.1:18080
# Optional host ports for the published frontend/backend (default 18080/18081).
KHAOYU_SERVICE_PUBLISH_PORT=18080
KHAOYU_SERVICE_PUBLISH_BACKEND_PORT=18081
KHAOYU_SERVICE_SHARE_PUBLIC_URL=http://127.0.0.1:18080
KHAOYU_SERVICE_COOKIE_SECURE=false
KHAOYU_SERVICE_TRUST_PROXY=true
KHAOYU_SERVICE_PUBLIC_SHARING=true

# Generate: openssl rand -hex 32 (at least 32 chars).
KHAOYU_SERVICE_SECRET=change-me-use-openssl-rand-hex-32

# CORS origins for the desktop app and the local web host. Add the board-app tunnel origin too.
KHAOYU_SERVICE_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://127.0.0.1:1430,http://localhost:1430

# PostgreSQL container credentials. Passwords should be URL-safe (setup-team.sh uses hex).
KHAOYU_SERVICE_POSTGRES_DB=khaoyu
KHAOYU_SERVICE_POSTGRES_USER=khaoyu
KHAOYU_SERVICE_POSTGRES_PASSWORD=change-me-postgres-password

# Redis container credentials.
KHAOYU_SERVICE_REDIS_PASSWORD=change-me-redis-password

# Generated by setup-team.sh; you can also set an initial owner manually.
KHAOYU_BOOTSTRAP_EMAIL=owner@localhost
KHAOYU_BOOTSTRAP_NAME="Owner"
KHAOYU_BOOTSTRAP_PROJECT="Khaoyu Note"
KHAOYU_BOOTSTRAP_PASSWORD=change-me-bootstrap-password

# Optional but recommended at-rest protection for backups and uploaded objects.
# Keep KHAOYU_SERVICE_OBJECT_KEY stable; rotating it requires re-encrypting existing objects.
KHAOYU_SERVICE_BACKUP_PASSPHRASE=change-me-backup-passphrase
KHAOYU_SERVICE_OBJECT_KEY=change-me-object-encryption-key-at-least-32-chars

# Optional: enable the cloudflared service with: --profile tunnel
CLOUDFLARE_TUNNEL_TOKEN=
