# Copy this file to .env and replace every value marked replace.
# The service refuses to start while KHAOYU_SERVICE_SECRET still looks like a placeholder.

KHAOYU_SERVICE_PROFILE=single-user
KHAOYU_SERVICE_HOST=0.0.0.0
# Leave these two empty for random free 5-digit ports. Docker Compose sets 18080 and 18081;
# set both when a reverse proxy needs a fixed frontend port.
KHAOYU_SERVICE_FRONTEND_PORT=
KHAOYU_SERVICE_BACKEND_PORT=
KHAOYU_SERVICE_DATA_DIR=/data

# Generate with: openssl rand -hex 32
KHAOYU_SERVICE_SECRET=replace-with-output-of-openssl-rand-hex-32

# Public HTTPS origin of the frontend port when a reverse proxy is used. Leave empty for the
# automatically chosen frontend URL.
KHAOYU_SERVICE_PUBLIC_URL=

# Optional origin used only in generated share links. Set this when the API is reached locally but
# shared boards are opened through a public IP, tunnel or reverse proxy. Defaults to PUBLIC_URL.
KHAOYU_SERVICE_SHARE_PUBLIC_URL=

# Cookies are Secure by default when the public URL is HTTPS. Set false only for local HTTP.
KHAOYU_SERVICE_COOKIE_SECURE=true
KHAOYU_SERVICE_TRUST_PROXY=true
KHAOYU_SERVICE_PUBLIC_SHARING=true
# Comma-separated CORS origins for the desktop client and the local web host. Credentials are never allowed.
# The web host origins are included by default; add your own origin when it runs on another port.
KHAOYU_SERVICE_CORS_ORIGINS=tauri://localhost,http://tauri.localhost,http://127.0.0.1:1430,http://localhost:1430
# Optional operator token for /api/v1/admin/*; at least 32 characters.
KHAOYU_SERVICE_ADMIN_TOKEN=
KHAOYU_SERVICE_BACKUP_PASSPHRASE=
# Optional AES-256-GCM key for uploaded objects at rest (at least 32 characters).
KHAOYU_SERVICE_OBJECT_KEY=
KHAOYU_SERVICE_ALERT_WEBHOOK=
# Optional trusted-proxy SSO. Requires trust proxy and a signing secret.
KHAOYU_SERVICE_SSO_ENABLED=false
KHAOYU_SERVICE_SSO_SECRET=
KHAOYU_SERVICE_SSO_HEADER=x-auth-request-email
KHAOYU_SERVICE_SSO_NAME_HEADER=x-auth-request-name
KHAOYU_SERVICE_SSO_AUTO_CREATE=false

# Optional Google OpenID Connect and GitHub OAuth sign-in. Both are disabled by default.
# Google: https://console.cloud.google.com/apis/credentials (Web application)
KHAOYU_SERVICE_GOOGLE_OIDC_ENABLED=false
KHAOYU_SERVICE_GOOGLE_CLIENT_ID=
KHAOYU_SERVICE_GOOGLE_CLIENT_SECRET=
KHAOYU_SERVICE_GOOGLE_REDIRECT_URL=
KHAOYU_SERVICE_GOOGLE_AUTO_CREATE=false
KHAOYU_SERVICE_GOOGLE_ALLOWED_DOMAINS=
# GitHub: Settings > Developer settings > OAuth Apps
KHAOYU_SERVICE_GITHUB_OAUTH_ENABLED=false
KHAOYU_SERVICE_GITHUB_CLIENT_ID=
KHAOYU_SERVICE_GITHUB_CLIENT_SECRET=
KHAOYU_SERVICE_GITHUB_REDIRECT_URL=
KHAOYU_SERVICE_GITHUB_AUTO_CREATE=false
KHAOYU_SERVICE_GITHUB_ALLOWED_DOMAINS=

# Team profile backend. Team mode requires both values and fails closed if either is missing.
# PostgreSQL is the system of record; Redis carries cross-instance SSE events and locks.
# PostgreSQL: postgres://user:password@host:5432/database
KHAOYU_SERVICE_DATABASE_URL=
KHAOYU_SERVICE_DATABASE_SSL=false
KHAOYU_SERVICE_DATABASE_POOL_MAX=10
# Redis: redis://:password@host:6379/0 or rediss://...
KHAOYU_SERVICE_REDIS_URL=
KHAOYU_SERVICE_REDIS_PREFIX=khaoyu
KHAOYU_SERVICE_INSTANCE_ID=
KHAOYU_SERVICE_REALTIME_TICKET_TTL_MS=60000
KHAOYU_SERVICE_EDIT_LOCK_TTL_MS=15000
KHAOYU_SERVICE_OP_RETENTION_DAYS=7
KHAOYU_SERVICE_COMPACT_OPS=100
KHAOYU_SERVICE_COMPACT_MS=30000

# Docker Compose team profile credentials (used by docker-compose.yml, not by the service directly).
KHAOYU_SERVICE_POSTGRES_DB=khaoyu
KHAOYU_SERVICE_POSTGRES_USER=khaoyu
KHAOYU_SERVICE_POSTGRES_PASSWORD=
KHAOYU_SERVICE_REDIS_PASSWORD=
# Refuse plain HTTP when the reverse proxy sets x-forwarded-proto.
KHAOYU_SERVICE_REQUIRE_HTTPS=false
# Optional scanner command receiving the uploaded temp file path.
KHAOYU_SERVICE_UPLOAD_SCAN_COMMAND=
# WebAuthn passkeys, served at /passkeys.
# Set false to temporarily disable passkey registration/login and hide the passkey UI.
KHAOYU_SERVICE_PASSKEYS_ENABLED=true
KHAOYU_SERVICE_RP_ID=

# Optional SMTP delivery. Without a host, mail is written to the outbox.
KHAOYU_SERVICE_SMTP_HOST=
KHAOYU_SERVICE_SMTP_PORT=587
KHAOYU_SERVICE_SMTP_SECURE=false
KHAOYU_SERVICE_SMTP_USER=
KHAOYU_SERVICE_SMTP_PASSWORD=
KHAOYU_SERVICE_SMTP_FROM=

KHAOYU_SERVICE_ACCESS_TTL_MINUTES=15
KHAOYU_SERVICE_REFRESH_TTL_DAYS=7
KHAOYU_SERVICE_DELETION_GRACE_DAYS=30
KHAOYU_SERVICE_LOGIN_WINDOW_MINUTES=15
KHAOYU_SERVICE_LOGIN_MAX_ATTEMPTS=5

KHAOYU_SERVICE_BACKUP_INTERVAL_HOURS=24
KHAOYU_SERVICE_BACKUP_RETENTION=7
KHAOYU_SERVICE_AUDIT_RETENTION_DAYS=90
KHAOYU_SERVICE_TEMP_MAX_AGE_HOURS=24
