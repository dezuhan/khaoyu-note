{
  "name": "@khaoyu-note/service",
  "version": "0.34.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted service foundation for Khaoyu Note",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "start:background": "node src/background.mjs",
    "stop": "node src/stop.mjs",
    "migrate": "node src/cli.mjs migrate",
    "rollback": "node src/cli.mjs rollback",
    "status": "node src/cli.mjs status",
    "bootstrap": "node src/cli.mjs bootstrap",
    "backup": "node src/cli.mjs backup",
    "restore": "node src/cli.mjs restore",
    "test": "node --test test/service.test.mjs test/auth.test.mjs test/admin.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.3",
    "hash-wasm": "4.12.0",
    "nodemailer": "^10.3.1"
  }
}
