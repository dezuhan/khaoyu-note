{
  "openapi": "3.1.0",
  "info": {
    "title": "Khaoyu Note sync API",
    "version": "1.0.0",
    "description": "Contract for the routes the desktop app and web editor use in Phase 0. Sharing and admin routes join in Phase 3."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "SyncTokenRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totp": {
            "type": "string"
          }
        }
      },
      "SyncTokenResponse": {
        "type": "object",
        "required": [
          "token",
          "email",
          "scopes",
          "expiresAt"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiresAt": {
            "type": "integer"
          }
        }
      },
      "Project": {
        "type": "object",
        "required": [
          "id",
          "name",
          "revision",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "commenter",
              "viewer"
            ]
          },
          "updatedAt": {
            "type": "integer"
          },
          "createdAt": {
            "type": "integer"
          },
          "parentProjectId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ProjectListResponse": {
        "type": "object",
        "required": [
          "projects"
        ],
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          }
        }
      },
      "ProjectResponse": {
        "type": "object",
        "required": [
          "project",
          "snapshot"
        ],
        "properties": {
          "project": {
            "type": "object",
            "required": [
              "id",
              "name",
              "revision",
              "lastSeq",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "revision": {
                "type": "integer"
              },
              "lastSeq": {
                "type": "integer"
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "editor",
                  "commenter",
                  "viewer"
                ]
              },
              "parentProjectId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publicSharingEnabled": {
                "type": "boolean"
              }
            }
          },
          "snapshot": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "revision",
              "doc",
              "updated_at"
            ],
            "properties": {
              "revision": {
                "type": "integer"
              },
              "doc": {
                "type": "string"
              },
              "updated_at": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Operation": {
        "type": "object",
        "required": [
          "opId",
          "type",
          "payload"
        ],
        "properties": {
          "opId": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "doc.replace",
              "doc.title",
              "card.add",
              "card.update",
              "card.delete",
              "card.move",
              "connections.set"
            ]
          },
          "payload": {
            "type": "object"
          },
          "clock": {
            "type": "object"
          }
        }
      },
      "OpsRequest": {
        "type": "object",
        "required": [
          "baseSeq",
          "ops"
        ],
        "properties": {
          "baseSeq": {
            "type": "integer",
            "minimum": 0
          },
          "ops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Operation"
            }
          }
        }
      },
      "OpsResponse": {
        "type": "object",
        "required": [
          "lastSeq",
          "revision",
          "fieldConflicts"
        ],
        "properties": {
          "idempotent": {
            "type": "boolean"
          },
          "seq": {
            "type": "integer"
          },
          "lastSeq": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "fieldConflicts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "ops": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "StoredOperation": {
        "type": "object",
        "required": [
          "seq",
          "opId",
          "type",
          "payload"
        ],
        "properties": {
          "seq": {
            "type": "integer"
          },
          "opId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "payload": {
            "type": "object"
          },
          "clock": {
            "type": [
              "object",
              "null"
            ]
          },
          "actor": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "integer"
          }
        }
      },
      "OpsListResponse": {
        "type": "object",
        "required": [
          "projectId",
          "lastSeq",
          "revision",
          "after",
          "ops",
          "hasMore"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "lastSeq": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "after": {
            "type": "integer"
          },
          "ops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoredOperation"
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "RealtimeTicket": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          }
        }
      },
      "PresenceRequest": {
        "type": "object",
        "required": [
          "connectionId"
        ],
        "properties": {
          "connectionId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cursor": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      },
      "LockRequest": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "LockResponse": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "LockReleaseResponse": {
        "type": "object",
        "required": [
          "released"
        ],
        "properties": {
          "released": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/sync-token": {
      "post": {
        "summary": "Issue a scoped sync token for the desktop app",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncTokenRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncTokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects": {
      "get": {
        "summary": "List projects visible to the account",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a project",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}": {
      "get": {
        "summary": "Project and snapshot",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/ops": {
      "post": {
        "summary": "Append an operation batch",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsResponse"
                }
              }
            }
          },
          "409": {
            "description": "Sequence conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Read operations after a sequence",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/realtime-ticket": {
      "post": {
        "summary": "Issue a single-use SSE ticket",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Ticket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealtimeTicket"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/presence": {
      "post": {
        "summary": "Update cursor and selection presence",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PresenceRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/locks": {
      "post": {
        "summary": "Acquire an edit lock",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LockRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Locked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LockResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Release an edit lock",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Released",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LockReleaseResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/projects/{projectId}/events": {
      "get": {
        "summary": "Server-sent events stream",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "projectId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticket",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
